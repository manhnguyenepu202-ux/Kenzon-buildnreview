# Copy to .env for local use. On Hostinger, add these in hPanel > Websites > Node.js app > Environment variables.

NODE_ENV=production
# Hostinger sets PORT automatically; only change it locally.
PORT=3000
SITE_URL=https://buildnreview.com

# MySQL (hPanel > Databases > MySQL Databases). With no DB_HOST, a local SQLite file is used instead.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_buildnreview
DB_USER=u123456789_bnr
DB_PASSWORD=change-me

# Admin login for /admin
ADMIN_EMAIL=admin@buildnreview.com
ADMIN_PASSWORD=choose-a-long-password

# Random string, at least 24 characters (signs the admin login cookie)
SESSION_SECRET=replace-with-a-long-random-string

# Load the starter reviews automatically when the database is empty (true/false)
AUTO_SEED=true
