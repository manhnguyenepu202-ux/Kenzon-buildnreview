{
  "name": "buildnreview",
  "version": "2.0.0",
  "private": true,
  "description": "BuildNReview: in-depth reviews and comparisons of 3D printers, DIY tools and home appliances.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
