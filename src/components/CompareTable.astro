---
import ProductArt from './ProductArt.astro';
import { useT, formatPrice, type Lang } from '../i18n/ui';
import { getCategory, scoreKeys, specLabels, specValue, type Product, type Review } from '../lib/catalog';

/**
 * Bảng so sánh. Mỗi sản phẩm là một cột có data-col.
 * Trang so sánh tương tác render sẵn mọi sản phẩm của danh mục rồi ẩn/hiện cột bằng JS.
 */
interface Props { lang: Lang; products: Product[]; reviews: Map<string, Review>; interactive?: boolean }
const { lang, products, reviews, interactive = false } = Astro.props;
const t = useT(lang);
const cat = getCategory(products[0].data.category);
const specKeys = cat.specOrder.filter((k) => products.some((p) => k in p.data.specs));
const best = (vals: number[]) => Math.max(...vals);
const overallBest = best(products.map((p) => p.overall));
const yes = t('yes'), no = t('no');
const cell = (p: Product, k: string) => (k in p.data.specs ? specValue(p.data.specs[k], yes, no) : '—');
---
<div class="scroller" tabindex="0" role="region" aria-label={t('compare.title')}>
  <table class="ct" data-compare-table={cat.id} hidden={interactive || undefined}>
    <caption class="visually-hidden">{t('compare.title')}: {cat.name[lang]}</caption>
    <thead>
      <tr>
        <td class="corner"></td>
        {products.map((p) => (
          <th scope="col" data-col={p.id}>
            <ProductArt type={p.data.type} tone={p.data.tone} label={p.data.name} />
            <span class="brand">{p.data.brand}</span>
            <a class="pname" href={`/${lang}/review/${p.id}/`}>{p.data.name}</a>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      <tr class="overall">
        <th scope="row">{t('score.overall')}</th>
        {products.map((p) => (
          <td data-col={p.id} data-s={p.overall} class:list={{ win: p.overall === overallBest && products.length > 1 }}>
            <span class="big num">{p.overall.toFixed(1)}</span>
            <span class="bar" style={`--w:${p.overall * 10}%`} aria-hidden="true"></span>
          </td>
        ))}
      </tr>
      {scoreKeys.map((k) => {
        const b = best(products.map((p) => p.data.scores[k]));
        return (
          <tr data-row>
            <th scope="row">{cat.scoreLabels[k][lang]}</th>
            {products.map((p) => (
              <td data-col={p.id} data-v={p.data.scores[k]} data-s={p.data.scores[k]} class:list={{ win: p.data.scores[k] === b && products.length > 1 }}>
                <span class="num">{p.data.scores[k].toFixed(1)}</span>
                <span class="bar" style={`--w:${p.data.scores[k] * 10}%`} aria-hidden="true"></span>
              </td>
            ))}
          </tr>
        );
      })}
      <tr data-row>
        <th scope="row">{t('review.price')}</th>
        {products.map((p) => <td data-col={p.id} data-v={p.data.price.usd} class="num">{formatPrice(lang, p.data.price)}</td>)}
      </tr>
      {specKeys.map((k) => (
        <tr data-row>
          <th scope="row">{specLabels[k]?.[lang] ?? k}</th>
          {products.map((p) => <td data-col={p.id} data-v={cell(p, k)} class="num">{cell(p, k)}</td>)}
        </tr>
      ))}
      <tr>
        <th scope="row">{t('review.bestFor')}</th>
        {products.map((p) => <td data-col={p.id}>{reviews.get(p.id)?.data.bestFor}</td>)}
      </tr>
      <tr>
        <th scope="row">{t('review.pros')}</th>
        {products.map((p) => <td data-col={p.id}><ul>{reviews.get(p.id)?.data.pros.map((x) => <li>{x}</li>)}</ul></td>)}
      </tr>
      <tr>
        <th scope="row">{t('review.cons')}</th>
        {products.map((p) => <td data-col={p.id}><ul>{reviews.get(p.id)?.data.cons.map((x) => <li>{x}</li>)}</ul></td>)}
      </tr>
      <tr>
        <td class="corner"></td>
        {products.map((p) => {
          const offer = p.data.offers.find((o) => o.lang === lang || o.lang === 'all');
          return (
            <td data-col={p.id} class="cta">
              {offer && <a class="btn btn-buy" href={offer.url} rel="sponsored nofollow noopener" target="_blank">{t('review.buyAt', { store: offer.store })}</a>}
              <a class="link" href={`/${lang}/review/${p.id}/`}>{t('card.read')}</a>
            </td>
          );
        })}
      </tr>
    </tbody>
  </table>
</div>

<style>
  .scroller { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .scroller:focus-visible { outline-offset: 4px; }
  .ct { width: 100%; min-width: 560px; border-collapse: separate; border-spacing: 0; table-layout: fixed; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-m); }
  .ct th, .ct td { padding: 14px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); font-size: var(--t-sm); }
  .ct tbody th { width: 190px; color: var(--steel); font-weight: 500; position: sticky; left: 0; background: var(--surface); z-index: 1; }
  .ct thead th { vertical-align: bottom; }
  .ct thead :global(.art) { border-radius: var(--radius-s); margin-bottom: var(--s-3); max-width: 200px; }
  .corner { width: 190px; }
  .brand { display: block; color: var(--steel); font-weight: 500; font-size: var(--t-xs); }
  .pname { font-size: var(--t-md); font-weight: 720; font-stretch: 110%; text-decoration: none; }
  .pname:hover { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 4px; }
  .big { font-size: var(--t-2xl); font-weight: 800; }
  .bar { display: block; height: 6px; margin-top: 6px; background: linear-gradient(90deg, var(--rule-strong) var(--w), var(--paper) var(--w)); }
  .win .bar { background: linear-gradient(90deg, var(--signal) var(--w), var(--paper) var(--w)); }
  .win .num, .win .big { font-weight: 800; }
  .ct td.num { font-weight: 600; }
  /* dòng có giá trị khác nhau giữa các cột */
  .ct :global(tr.diff) td { background: #fff7f1; }
  .ct :global(tr.diff) th { box-shadow: inset 3px 0 0 var(--signal); }
  .ct ul { padding-left: 1em; display: grid; gap: 4px; }
  .cta { display: table-cell; }
  .cta .btn { width: 100%; margin-bottom: var(--s-3); }
  .ct :global([data-col][hidden]) { display: none; }
  @media (max-width: 640px) { .ct tbody th, .corner { width: 120px; } }
</style>

<script>
  // Tô sáng dòng khác nhau giữa các cột đang hiện.
  function markDiffs(table: HTMLTableElement) {
    for (const row of table.querySelectorAll<HTMLTableRowElement>('tr[data-row]')) {
      const vals = [...row.querySelectorAll<HTMLElement>('td[data-col]:not([hidden])')].map((td) => td.dataset.v);
      row.classList.toggle('diff', new Set(vals).size > 1);
    }
    // điểm cao nhất trong các cột đang hiện
    for (const row of table.querySelectorAll<HTMLTableRowElement>('tr')) {
      const cells = [...row.querySelectorAll<HTMLElement>('td[data-s]:not([hidden])')];
      if (!cells.length) continue;
      const max = Math.max(...cells.map((c) => +c.dataset.s!));
      cells.forEach((c) => c.classList.toggle('win', cells.length > 1 && +c.dataset.s! === max));
    }
  }
  document.querySelectorAll<HTMLTableElement>('table[data-compare-table]').forEach(markDiffs);
  window.addEventListener('compare:columns', (e) => markDiffs((e as CustomEvent<HTMLTableElement>).detail));
</script>
