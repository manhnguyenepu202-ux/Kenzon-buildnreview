---
import Logo from './Logo.astro';
import { useT, type Lang } from '../i18n/ui';
import { categories } from '../lib/catalog';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <Logo href={`/${lang}/`} light />
      <p>{t('footer.about')}</p>
    </div>
    <nav aria-label={t('nav.categories')}>
      <h2>{t('nav.categories')}</h2>
      <ul>
        {categories.map((c) => <li><a href={`/${lang}/category/${c.id}/`}>{c.name[lang]}</a></li>)}
        <li><a href={`/${lang}/compare/`}>{t('nav.compare')}</a></li>
      </ul>
    </nav>
    <nav aria-label="BuildNReview">
      <h2>BuildNReview</h2>
      <ul>
        <li><a href={`/${lang}/how-we-test/`}>{t('nav.howWeTest')}</a></li>
        <li><a href={`/${lang}/disclosure/`}>{t('footer.disclosure')}</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap legal">
    <p>© {year} BuildNReview. {t('footer.rights')}</p>
    <p>{t('review.affiliate')}</p>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: var(--on-ink); padding-top: var(--s-8); margin-top: var(--s-9); }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: var(--s-7); }
  .about p { color: var(--on-ink-muted); margin-top: var(--s-4); max-width: 42ch; font-size: var(--t-sm); }
  h2 { font-size: var(--t-sm); font-weight: 700; margin-bottom: var(--s-3); color: var(--on-ink); }
  ul { list-style: none; display: grid; gap: 2px; }
  ul a { display: inline-flex; min-height: 36px; align-items: center; color: var(--on-ink-muted); text-decoration: none; font-size: var(--t-sm); }
  ul a:hover { color: var(--on-ink); text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 4px; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-7); padding-block: var(--s-5); border-top: 1px solid #2a4570; font-size: var(--t-xs); color: var(--on-ink-muted); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
