---
interface Props { href: string; light?: boolean }
const { href, light = false } = Astro.props;
---
<a class:list={['logo', { light }]} href={href} aria-label="BuildNReview">
  <svg viewBox="0 0 36 36" width="34" height="34" aria-hidden="true">
    <rect width="36" height="36" rx="7" fill="#10284a" />
    <path d="M7 27h22" stroke="#f3f6fa" stroke-width="2.2" stroke-linecap="round" />
    <path d="M10 27v-6M15 27v-9M20 27v-12M25 27v-16" stroke="#f26a1b" stroke-width="2.6" stroke-linecap="round" />
  </svg>
  <span class="word">Build<span class="n">N</span>Review</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .logo.light { color: var(--on-ink); }
  .logo.light rect { fill: #f3f6fa; }
  .logo.light path:first-of-type { stroke: #10284a; }
  .word { font-size: 1.2rem; font-weight: 780; font-stretch: 118%; letter-spacing: -0.02em; }
  .n { font-weight: 380; color: var(--steel); }
  .light .n { color: var(--on-ink-muted); }
</style>
