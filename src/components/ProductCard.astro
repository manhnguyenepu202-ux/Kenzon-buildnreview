---
import ProductArt from './ProductArt.astro';
import ScoreRuler from './ScoreRuler.astro';
import CompareToggle from './CompareToggle.astro';
import { useT, formatPrice, type Lang } from '../i18n/ui';
import { types, type Product } from '../lib/catalog';

interface Props { product: Product; lang: Lang; headingLevel?: 'h2' | 'h3'; compare?: boolean; eager?: boolean }
const { product, lang, headingLevel = 'h3', compare = false, eager = false } = Astro.props;
const t = useT(lang);
const d = product.data;
const H = headingLevel;
const href = `/${lang}/review/${product.id}/`;
---
<article class="card" data-category={d.category} data-type={d.type} data-score={product.overall} data-price={d.price.usd} data-released={d.released}>
  <ProductArt type={d.type} tone={d.tone} label={d.name} eager={eager} />
  <div class="body">
    <p class="brand">{d.brand}</p>
    <H class="name display"><a href={href}>{d.model}</a></H>
    <p class="type">{types[d.type]?.[lang]}</p>
    <ScoreRuler value={product.overall} size="sm" label={t('card.score')} />
    <div class="foot">
      <span class="price num">{formatPrice(lang, d.price)}</span>
      {compare && <CompareToggle lang={lang} slug={product.id} category={d.category} name={d.name} compact />}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex; flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    overflow: hidden;
    transition: border-color .18s var(--ease);
  }
  .card:hover { border-color: var(--ink); }
  .card:focus-within { border-color: var(--ink); }
  .body { display: flex; flex-direction: column; gap: 6px; padding: var(--s-4) var(--s-4) var(--s-4); flex: 1; }
  .brand { font-size: var(--t-sm); color: var(--steel); }
  .name { font-size: var(--t-lg); }
  .name a { text-decoration: none; }
  /* cả thẻ bấm được, nhưng nút so sánh vẫn bấm riêng */
  .name a::after { content: ''; position: absolute; inset: 0; }
  .name a:focus-visible { outline: none; }
  .card:has(.name a:focus-visible) { outline: 3px solid var(--signal); outline-offset: 2px; }
  .type { font-size: var(--t-xs); color: var(--steel); margin-bottom: var(--s-3); }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-top: auto; padding-top: var(--s-3); }
  .price { font-weight: 650; }
  .foot :global(button) { position: relative; z-index: 1; }
</style>
