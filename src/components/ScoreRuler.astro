---
/**
 * Thước đo điểm: vạch chia 0–10 như thước kẹp, phần đã đạt tô cam.
 * Đây là yếu tố nhận diện chính của thương hiệu; dùng thống nhất ở thẻ, bài review và bảng so sánh.
 */
interface Props { value: number; label?: string; size?: 'sm' | 'md' | 'lg'; dark?: boolean }
const { value, label, size = 'md', dark = false } = Astro.props;
const pct = Math.max(0, Math.min(100, value * 10));
// 21 vạch: vạch lớn ở mỗi điểm, vạch nhỏ ở mỗi nửa điểm
const ticks = Array.from({ length: 21 }, (_, i) => ({ x: i * 5, major: i % 2 === 0 }));
---
<div class:list={['ruler', size, { dark }]} role="img" aria-label={`${label ? label + ': ' : ''}${value.toFixed(1)}/10`}>
  {label && <span class="label">{label}</span>}
  <span class="track" aria-hidden="true">
    <span class="fill" style={`width:${pct}%`}></span>
    <svg viewBox="0 0 100 10" preserveAspectRatio="none">
      {ticks.map((t) => (
        <line x1={t.x} x2={t.x} y1={t.major ? 0 : 5} y2="10" class={t.major ? 'major' : 'minor'} vector-effect="non-scaling-stroke" />
      ))}
      <line x1="0" x2="100" y1="10" y2="10" class="major base" vector-effect="non-scaling-stroke" />
    </svg>
  </span>
  <span class="value num" aria-hidden="true">{value.toFixed(1)}</span>
</div>

<style>
  .ruler {
    --h: 14px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'label label' 'track value';
    align-items: end;
    column-gap: 12px;
    row-gap: 4px;
  }
  .label { grid-area: label; font-size: var(--t-sm); color: var(--steel); }
  .track { grid-area: track; position: relative; height: var(--h); }
  .track svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .major { stroke: var(--ink); stroke-width: 1.5; }
  .minor { stroke: var(--rule-strong); stroke-width: 1; }
  .base { stroke-width: 2; }
  .fill { position: absolute; left: 0; bottom: 0; height: 55%; background: var(--signal); }
  .value { grid-area: value; font-weight: 760; font-size: var(--t-lg); line-height: 1; min-width: 2.4ch; text-align: right; }

  .sm { --h: 10px; }
  .sm .value { font-size: var(--t-md); }
  .lg { --h: 22px; }
  .lg .value { font-size: 2.6rem; font-stretch: var(--narrow); }

  .dark .label { color: var(--on-ink-muted); }
  .dark .major { stroke: var(--on-ink); }
  .dark .minor { stroke: #6f84a3; }
  .dark .value { color: var(--on-ink); }
</style>
