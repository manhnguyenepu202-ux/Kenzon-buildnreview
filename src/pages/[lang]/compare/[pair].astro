---
import Base from '../../../layouts/Base.astro';
import CompareTable from '../../../components/CompareTable.astro';
import ScoreRuler from '../../../components/ScoreRuler.astro';
import { useT, langs, type Lang } from '../../../i18n/ui';
import { getProducts, getReviewMap, getCategory, matchups, matchupSlug, scoreKeys } from '../../../lib/catalog';

export function getStaticPaths() {
  return langs.flatMap((lang) => matchups.map((m) => ({ params: { lang, pair: matchupSlug(m) }, props: { pair: m } })));
}
const { pair } = Astro.props as { pair: [string, string] };
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const all = await getProducts();
const [a, b] = pair.map((s) => all.find((p) => p.id === s)!);
const reviews = await getReviewMap(lang);
const cat = getCategory(a.data.category);
const winner = a.overall >= b.overall ? a : b;
const other = winner === a ? b : a;
const strengths = (x: typeof a, y: typeof a) => scoreKeys.filter((k) => x.data.scores[k] > y.data.scores[k]).map((k) => cat.scoreLabels[k][lang].toLowerCase());
const wS = strengths(winner, other);
const oS = strengths(other, winner);
const title = `${a.data.name} ${t('compare.vs')} ${b.data.name}`;
const summary = lang === 'vi'
  ? `${winner.data.name} đạt ${winner.overall.toFixed(1)} điểm, nhỉnh hơn ${other.data.name} (${other.overall.toFixed(1)}).`
  : `${winner.data.name} scores ${winner.overall.toFixed(1)}, ahead of ${other.data.name} (${other.overall.toFixed(1)}).`;
const advice = lang === 'vi'
  ? `Chọn ${winner.data.name} nếu bạn coi trọng ${wS.join(', ') || 'tổng thể'}. Chọn ${other.data.name} nếu ưu tiên ${oS.join(', ') || 'giá'}.`
  : `Pick the ${winner.data.name} if you care most about ${wS.join(', ') || 'overall balance'}. Pick the ${other.data.name} if ${oS.length ? oS.join(', ') + ' matters more' : 'price matters more'}.`;
---
<Base lang={lang} title={title} description={`${summary} ${advice}`}>
  <header class="head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`/${lang}/`}>{t('breadcrumb.home')}</a> / <a href={`/${lang}/compare/`}>{t('nav.compare')}</a>
      </nav>
      <h1 class="display">{a.data.name} <span class="vs">{t('compare.vs')}</span> {b.data.name}</h1>
      <div class="duel">
        <ScoreRuler value={a.overall} label={a.data.name} dark />
        <ScoreRuler value={b.overall} label={b.data.name} dark />
      </div>
    </div>
  </header>

  <div class="wrap section">
    <section class="verdict">
      <h2>{t('compare.verdict')}</h2>
      <p><strong>{summary}</strong> {advice}</p>
    </section>
    <CompareTable lang={lang} products={[a, b]} reviews={reviews} />
    <p class="more"><a class="link" href={`/${lang}/compare/?p=${a.id},${b.id}`}>{t('compare.openTool')}</a></p>
  </div>
</Base>

<style>
  .head { background: var(--ink); color: var(--on-ink); padding: var(--s-6) 0 var(--s-7); }
  .crumbs { font-size: var(--t-sm); color: var(--on-ink-muted); }
  .crumbs a { color: var(--on-ink-muted); }
  h1 { font-size: clamp(1.9rem, 1.2rem + 3vw, 3.6rem); font-weight: 820; margin: var(--s-4) 0 var(--s-6); max-width: 22ch; }
  .vs { font-weight: 300; font-stretch: 100%; color: var(--on-ink-muted); }
  .duel { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-7); max-width: 820px; }
  .verdict { border-left: 4px solid var(--signal); padding: var(--s-2) 0 var(--s-2) var(--s-5); margin-bottom: var(--s-7); max-width: 72ch; }
  .verdict h2 { font-size: var(--t-xl); margin-bottom: var(--s-3); }
  .more { margin-top: var(--s-5); }
  @media (max-width: 640px) { .duel { grid-template-columns: 1fr; gap: var(--s-4); } }
</style>
