---
import Base from '../../../layouts/Base.astro';
import CompareTable from '../../../components/CompareTable.astro';
import { useT, staticPaths, type Lang } from '../../../i18n/ui';
import { getProducts, getReviewMap, categories, matchups, matchupSlug } from '../../../lib/catalog';

export const getStaticPaths = staticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const products = await getProducts();
const reviews = await getReviewMap(lang);
const byCat = categories.map((c) => ({ cat: c, items: products.filter((p) => p.data.category === c.id) }));
const options = products.map((p) => ({ slug: p.id, name: p.data.name, category: p.data.category }));
---
<Base lang={lang} title={t('compare.title')} description={t('compare.lead')}>
  <header class="head">
    <div class="wrap">
      <h1 class="display">{t('compare.title')}</h1>
      <p>{t('compare.lead')}</p>
    </div>
  </header>

  <div class="wrap section" data-compare-app data-lang={lang}>
    <script type="application/json" data-options set:html={JSON.stringify(options)} />
    <form class="picker" onsubmit="return false">
      <label>
        <span>{t('compare.pickCategory')}</span>
        <select data-cat>
          {categories.map((c) => <option value={c.id}>{c.name[lang]}</option>)}
        </select>
      </label>
      {[0, 1, 2].map((i) => (
        <label>
          <span>{t('compare.pick')} {i + 1}</span>
          <select data-slot={i}><option value="">—</option></select>
        </label>
      ))}
      <label class="diff-toggle">
        <input type="checkbox" data-only-diff />
        <span>{t('compare.onlyDiff')}</span>
      </label>
    </form>

    <p class="empty" data-empty>{t('compare.empty')}</p>
    {byCat.map(({ items }) => <CompareTable lang={lang} products={items} reviews={reviews} interactive />)}

    <section class="matchups">
      <h2>{t('home.matchups')}</h2>
      <ul>
        {matchups.map((m) => {
          const [a, b] = m.map((s) => products.find((p) => p.id === s)!);
          return <li><a class="chip" href={`/${lang}/compare/${matchupSlug(m)}/`}>{a.data.name} {t('compare.vs')} {b.data.name}</a></li>;
        })}
      </ul>
    </section>
  </div>
</Base>

<script>
  type Opt = { slug: string; name: string; category: string };
  const app = document.querySelector<HTMLElement>('[data-compare-app]')!;
  const options: Opt[] = JSON.parse(app.querySelector('[data-options]')!.textContent!);
  const catSel = app.querySelector<HTMLSelectElement>('[data-cat]')!;
  const slots = [...app.querySelectorAll<HTMLSelectElement>('[data-slot]')];
  const onlyDiff = app.querySelector<HTMLInputElement>('[data-only-diff]')!;
  const empty = app.querySelector<HTMLElement>('[data-empty]')!;
  const KEY = 'bnr-compare';

  const stored = (): { category: string | null; items: { slug: string; name: string }[] } => {
    try { return JSON.parse(localStorage.getItem(KEY) || '') ; } catch { return { category: null, items: [] }; }
  };

  function fillSlots(category: string, picked: string[]) {
    const opts = options.filter((o) => o.category === category);
    slots.forEach((sel, i) => {
      sel.innerHTML = '<option value="">—</option>' + opts.map((o) => `<option value="${o.slug}">${o.name}</option>`).join('');
      sel.value = picked[i] && opts.some((o) => o.slug === picked[i]) ? picked[i] : '';
    });
  }

  function apply(save = true) {
    const category = catSel.value;
    const picked = [...new Set(slots.map((s) => s.value).filter(Boolean))];
    let anyTable = false;
    for (const table of app.querySelectorAll<HTMLTableElement>('table[data-compare-table]')) {
      const active = table.dataset.compareTable === category && picked.length > 0;
      table.hidden = !active;
      table.parentElement!.hidden = !active;
      if (!active) continue;
      anyTable = true;
      table.querySelectorAll<HTMLElement>('[data-col]').forEach((el) => (el.hidden = !picked.includes(el.dataset.col!)));
      // sắp cột theo thứ tự đã chọn
      for (const row of table.rows) {
        const cells = [...row.cells].filter((c) => c.dataset.col);
        picked.forEach((slug) => { const c = cells.find((x) => x.dataset.col === slug); if (c) row.append(c); });
      }
      window.dispatchEvent(new CustomEvent('compare:columns', { detail: table }));
      table.classList.toggle('only-diff', onlyDiff.checked);
    }
    empty.hidden = anyTable;
    const url = new URL(location.href);
    if (picked.length) url.searchParams.set('p', picked.join(',')); else url.searchParams.delete('p');
    history.replaceState(null, '', url);
    if (save) {
      const items = picked.map((slug) => ({ slug, name: options.find((o) => o.slug === slug)!.name }));
      try { localStorage.setItem(KEY, JSON.stringify({ category: items.length ? category : null, items })); } catch { /* bỏ qua */ }
    }
  }

  // Khởi tạo từ ?p=... hoặc từ danh sách đã lưu
  const fromUrl = (new URL(location.href).searchParams.get('p') || '').split(',').filter((s) => options.some((o) => o.slug === s));
  const initial = fromUrl.length ? fromUrl : stored().items?.map((i) => i.slug) ?? [];
  const firstCat = options.find((o) => o.slug === initial[0])?.category ?? catSel.value;
  catSel.value = firstCat;
  fillSlots(firstCat, initial.filter((s) => options.find((o) => o.slug === s)?.category === firstCat).slice(0, 3));
  apply(fromUrl.length > 0);

  catSel.addEventListener('change', () => { fillSlots(catSel.value, []); apply(); });
  slots.forEach((s) => s.addEventListener('change', () => apply()));
  onlyDiff.addEventListener('change', () => apply(false));
</script>

<style>
  .head { background: var(--ink); color: var(--on-ink); padding: var(--s-7) 0;
    background-image: linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 32px 32px; }
  h1 { font-size: var(--t-3xl); font-weight: 820; }
  .head p { margin-top: var(--s-3); color: var(--on-ink-muted); max-width: 60ch; }
  .picker { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)) auto; gap: var(--s-4); align-items: end; margin-bottom: var(--s-6); }
  .picker label { display: grid; gap: 6px; font-size: var(--t-sm); color: var(--steel); }
  .picker select { min-height: 46px; padding: 0 12px; border: 1px solid var(--rule-strong); border-radius: var(--radius-s); background: var(--surface); color: var(--ink); width: 100%; }
  .diff-toggle { display: flex !important; align-items: center; gap: 10px !important; min-height: 46px; color: var(--ink) !important; cursor: pointer; }
  .diff-toggle input { width: 20px; height: 20px; accent-color: var(--ink); }
  .empty { padding: var(--s-7) var(--s-5); border: 1.5px dashed var(--rule-strong); border-radius: var(--radius-m); text-align: center; color: var(--steel); }
  .empty[hidden] { display: none; }
  :global(table.only-diff tr[data-row]:not(.diff)) { display: none; }
  .matchups { margin-top: var(--s-8); }
  .matchups h2 { font-size: var(--t-xl); margin-bottom: var(--s-4); }
  .matchups ul { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; }
  @media (max-width: 900px) { .picker { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .picker { grid-template-columns: 1fr; } }
</style>
