---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductArt from '../../components/ProductArt.astro';
import ScoreRuler from '../../components/ScoreRuler.astro';
import { useT, staticPaths, type Lang } from '../../i18n/ui';
import { getProducts, categories, scoreKeys, scoreWeights, matchups, matchupSlug, types } from '../../lib/catalog';

export const getStaticPaths = staticPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const products = await getProducts();
const bySlug = new Map(products.map((p) => [p.id, p]));

const mostRead = [...products].sort((a, b) => b.data.views - a.data.views).slice(0, 8);
const top = products[0];
const topCat = categories.find((c) => c.id === top.data.category)!;
const popular = lang === 'vi' ? ['Bambu Lab', 'Makita', 'Nồi chiên', 'Robot hút bụi'] : ['Bambu Lab', 'Makita', 'Air fryer', 'Robot vacuum'];
const repType: Record<string, string> = { '3d-printers': 'fdm-enclosed', tools: 'drill-driver', home: 'air-fryer' };

const steps = lang === 'vi'
  ? [
      ['Mua hoặc mượn bản bán lẻ', 'Không dùng máy do hãng chọn sẵn. Mọi máy chạy cùng bộ bài thử theo danh mục.'],
      ['Đo bốn tiêu chí', 'Hiệu năng, độ hoàn thiện, độ dễ dùng và giá trị, mỗi tiêu chí chấm 0–10.'],
      ['Tính điểm tổng có trọng số', 'Trọng số công khai và giống nhau cho mọi sản phẩm cùng danh mục.'],
      ['Cập nhật khi thị trường đổi', 'Giá giảm hay có phiên bản mới, điểm giá trị và kết luận được xem lại.'],
    ]
  : [
      ['Buy or borrow retail units', 'No hand-picked review samples. Every product runs the same category test suite.'],
      ['Measure four criteria', 'Performance, build quality, ease of use and value, each scored 0–10.'],
      ['Weight the overall score', 'Weights are published and identical for every product in a category.'],
      ['Revisit when the market moves', 'When prices drop or new versions ship, value scores and verdicts are reviewed.'],
    ];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'BuildNReview',
  url: new URL(`/${lang}/`, Astro.site).href,
  inLanguage: lang,
  potentialAction: {
    '@type': 'SearchAction',
    target: new URL(`/${lang}/search/?q={search_term_string}`, Astro.site).href,
    'query-input': 'required name=search_term_string',
  },
};
---
<Base lang={lang} title={`BuildNReview: ${t('home.title')}`} description={t('site.tagline')} jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="display">{t('home.title')}</h1>
        <p class="lead">{t('home.lead')}</p>
        <SearchBox lang={lang} id="q-hero" placeholder={t('search.heroPlaceholder', { n: products.length })} />
        <div class="popular">
          <span>{t('search.try')}</span>
          <ul>
            {popular.map((p) => <li><a class="chip" href={`/${lang}/search/?q=${encodeURIComponent(p)}`}>{p}</a></li>)}
          </ul>
        </div>
      </div>

      <aside class="sheet" aria-labelledby="sheet-title">
        <div class="sheet-head">
          <p>{t('home.sheetTop')}</p>
          <p class="sheet-cat">{topCat.name[lang]}</p>
        </div>
        <div class="sheet-product">
          <ProductArt type={top.data.type} tone={top.data.tone} label={top.data.name} eager />
          <div>
            <p class="sheet-brand">{top.data.brand}</p>
            <h2 id="sheet-title" class="display">{top.data.model}</h2>
          </div>
        </div>
        <ScoreRuler value={top.overall} size="lg" label={t('score.overall')} />
        <div class="sheet-rows">
          {scoreKeys.map((k) => <ScoreRuler value={top.data.scores[k]} size="sm" label={topCat.scoreLabels[k][lang]} />)}
        </div>
        <a class="btn btn-line sheet-cta" href={`/${lang}/review/${top.id}/`}>{t('card.read')}</a>
      </aside>
    </div>

    <nav class="wrap drawers" aria-label={t('home.browse')}>
      {categories.map((c) => {
        const count = products.filter((p) => p.data.category === c.id).length;
        return (
          <a class="drawer" href={`/${lang}/category/${c.id}/`}>
            <span class="drawer-art"><ProductArt type={repType[c.id]} tone="#5b7fae" label="" /></span>
            <span class="drawer-text">
              <span class="drawer-name display">{c.name[lang]}</span>
              <span class="drawer-blurb">{c.blurb[lang]}</span>
            </span>
            <span class="drawer-count num">{t('category.count', { n: count })}</span>
          </a>
        );
      })}
    </nav>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{t('home.mostRead')}</h2>
          <p>{t('home.mostReadLead')}</p>
        </div>
      </div>
      <div class="grid">
        {mostRead.map((p, i) => <ProductCard product={p} lang={lang} compare eager={i < 4} />)}
      </div>
    </div>
  </section>

  <section class="section matchups-section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>{t('home.matchups')}</h2>
          <p>{t('home.matchupsLead')}</p>
        </div>
        <a class="link" href={`/${lang}/compare/`}>{t('compare.openTool')}</a>
      </div>
      <ul class="matchups">
        {matchups.map((m) => {
          const [a, b] = m.map((s) => bySlug.get(s)!);
          return (
            <li>
              <a href={`/${lang}/compare/${matchupSlug(m)}/`}>
                <span class="m-side">
                  <span class="m-name">{a.data.name}</span>
                  <span class:list={['m-score num', { win: a.overall >= b.overall }]}>{a.overall.toFixed(1)}</span>
                </span>
                <span class="m-vs">{t('compare.vs')}</span>
                <span class="m-side right">
                  <span class:list={['m-score num', { win: b.overall > a.overall }]}>{b.overall.toFixed(1)}</span>
                  <span class="m-name">{b.data.name}</span>
                </span>
                <span class="m-type">{types[a.data.type][lang]}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap process">
      <div>
        <h2 class="display">{t('home.process')}</h2>
        <p class="process-lead">
          {lang === 'vi'
            ? `Điểm tổng = ${scoreKeys.map((k) => `${Math.round(scoreWeights[k] * 100)}%`).join(' + ')} của bốn tiêu chí.`
            : `Overall = ${scoreKeys.map((k) => `${Math.round(scoreWeights[k] * 100)}%`).join(' + ')} of the four criteria.`}
        </p>
        <a class="link" href={`/${lang}/how-we-test/`}>{t('nav.howWeTest')}</a>
      </div>
      <ol>
        {steps.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>
</Base>

<style>
  .hero {
    background-color: var(--ink);
    background-image:
      linear-gradient(rgba(255, 255, 255, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .045) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--on-ink);
    padding-top: clamp(40px, 7vw, 96px);
  }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  h1 { font-size: var(--t-3xl); font-weight: 820; line-height: 1.0; max-width: 11ch; }
  .lead { margin: var(--s-5) 0 var(--s-6); color: var(--on-ink-muted); max-width: 56ch; font-size: var(--t-md); }
  .popular { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-4); font-size: var(--t-sm); color: var(--on-ink-muted); }
  .popular ul { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; }
  .popular .chip { color: var(--on-ink); border-color: #3d5a87; }
  .popular .chip:hover { border-color: var(--on-ink); }

  /* Phiếu chấm: điểm nhấn của trang */
  .sheet {
    background: var(--surface); color: var(--ink);
    border-radius: var(--radius-m);
    padding: var(--s-5);
    display: grid; gap: var(--s-4);
    box-shadow: 10px 10px 0 var(--signal);
    transform: rotate(-1.2deg);
  }
  .sheet-head { display: flex; justify-content: space-between; gap: var(--s-3); font-size: var(--t-xs); color: var(--steel); border-bottom: 1px dashed var(--rule-strong); padding-bottom: var(--s-3); }
  .sheet-cat { font-weight: 650; color: var(--ink); }
  .sheet-product { display: grid; grid-template-columns: 120px 1fr; gap: var(--s-4); align-items: center; }
  .sheet-product :global(.art) { border-radius: var(--radius-s); }
  .sheet-brand { font-size: var(--t-sm); color: var(--steel); }
  .sheet h2 { font-size: var(--t-xl); }
  .sheet-rows { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3) var(--s-5); padding-top: var(--s-2); }
  .sheet-cta { justify-self: start; }

  .drawers { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(48px, 7vw, 88px); border-top: 1px solid #2a4570; }
  .drawer {
    display: grid; grid-template-columns: 72px 1fr; grid-template-rows: auto auto; gap: 4px var(--s-4);
    padding: var(--s-5) var(--s-4) var(--s-6); text-decoration: none; color: var(--on-ink);
    border-right: 1px solid #2a4570; transition: background-color .18s var(--ease);
  }
  .drawer:last-child { border-right: 0; }
  .drawer:hover { background: var(--ink-2); }
  .drawer-art { grid-row: 1 / span 2; }
  .drawer-art :global(.art) { padding: 6%; border-radius: var(--radius-s); background-color: #e8eef5; }
  .drawer-text { display: grid; gap: 4px; }
  .drawer-name { font-size: var(--t-lg); font-weight: 760; }
  .drawer-blurb { font-size: var(--t-sm); color: var(--on-ink-muted); }
  .drawer-count { grid-column: 2; font-size: var(--t-xs); color: var(--signal); font-weight: 650; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: var(--s-5); }

  .matchups-section { background: var(--surface); border-block: 1px solid var(--rule); }
  .matchups { list-style: none; border-top: 2px solid var(--ink); }
  .matchups a {
    display: grid; grid-template-columns: 1fr auto 1fr; grid-template-areas: 'a vs b' 'type type type';
    align-items: center; gap: 4px var(--s-5); padding: var(--s-5) var(--s-2);
    border-bottom: 1px solid var(--rule); text-decoration: none;
  }
  .matchups a:hover { background: #f4f7fa; }
  .matchups a:hover .m-name { text-decoration: underline; text-decoration-color: var(--signal); text-underline-offset: 4px; }
  .m-side { display: flex; align-items: center; gap: var(--s-4); justify-content: flex-end; text-align: right; }
  .m-side.right { justify-content: flex-start; text-align: left; }
  .m-side.right { grid-area: b; }
  .m-name { font-size: var(--t-lg); font-weight: 680; font-stretch: 110%; }
  .m-score { font-size: var(--t-xl); font-weight: 780; color: var(--steel); }
  .m-score.win { color: var(--ink); box-shadow: inset 0 -6px 0 var(--signal); }
  .m-vs { grid-area: vs; font-size: var(--t-sm); color: var(--steel); }
  .m-type { grid-area: type; font-size: var(--t-xs); color: var(--steel); text-align: center; }

  .process { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--s-8); }
  .process h2 { font-size: var(--t-2xl); max-width: 14ch; }
  .process-lead { margin: var(--s-4) 0 var(--s-5); color: var(--steel); }
  .process ol { list-style: none; padding: 0; margin: 0; counter-reset: step; display: grid; gap: 0; }
  .process li { counter-increment: step; display: grid; grid-template-columns: 56px 1fr; gap: 2px var(--s-4); padding: var(--s-5) 0; border-top: 1px solid var(--rule-strong); }
  .process li::before { content: counter(step); grid-row: 1 / span 2; font-size: var(--t-xl); font-weight: 800; font-stretch: var(--narrow); color: var(--signal-text); font-variant-numeric: tabular-nums; }
  .process h3 { font-size: var(--t-lg); }
  .process li p { color: var(--steel); }

  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; }
    .sheet { transform: none; max-width: 520px; }
    .drawers { grid-template-columns: 1fr; }
    .drawer { border-right: 0; border-bottom: 1px solid #2a4570; }
    .process { grid-template-columns: 1fr; gap: var(--s-6); }
  }
  @media (max-width: 640px) {
    .matchups a { grid-template-columns: 1fr; grid-template-areas: 'a' 'vs' 'b' 'type'; }
    .m-side, .m-side.right { justify-content: space-between; text-align: left; }
    .m-side.right { flex-direction: row-reverse; }
    .m-type { text-align: left; }
    .sheet-rows { grid-template-columns: 1fr; }
  }
</style>
