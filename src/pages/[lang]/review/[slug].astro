---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProductArt from '../../../components/ProductArt.astro';
import ScoreRuler from '../../../components/ScoreRuler.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CompareToggle from '../../../components/CompareToggle.astro';
import Icon from '../../../components/Icon.astro';
import { useT, langs, formatPrice, formatDate, type Lang } from '../../../i18n/ui';
import { getProducts, getReview, getCategory, scoreKeys, specLabels, specValue, types, type Product } from '../../../lib/catalog';

export async function getStaticPaths() {
  const products = await getProducts();
  const paths = [];
  for (const lang of langs) {
    for (const product of products) {
      const review = await getReview(lang, product.id);
      if (review) paths.push({ params: { lang, slug: product.id }, props: { product, review, products } });
    }
  }
  return paths;
}

const { product, review, products } = Astro.props as {
  product: Product;
  review: NonNullable<Awaited<ReturnType<typeof getReview>>>;
  products: Product[];
};
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const d = product.data;
const r = review.data;
const cat = getCategory(d.category);
const { Content } = await render(review);
const offers = d.offers.filter((o) => o.lang === lang || o.lang === 'all');
const specs = [...cat.specOrder.filter((k) => k in d.specs), ...Object.keys(d.specs).filter((k) => !cat.specOrder.includes(k))];
const related = products.filter((p) => p.data.category === d.category && p.id !== product.id).slice(0, 4);
const url = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: d.name,
    brand: { '@type': 'Brand', name: d.brand },
    model: d.model,
    category: types[d.type]?.[lang],
    description: r.summary,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: lang === 'vi' ? 'VND' : 'USD',
      lowPrice: lang === 'vi' ? d.price.vnd : d.price.usd,
      offerCount: Math.max(1, offers.length),
    },
    review: {
      '@type': 'Review',
      name: r.title,
      author: { '@type': 'Organization', name: r.author },
      datePublished: r.published.toISOString().slice(0, 10),
      dateModified: (r.updated ?? r.published).toISOString().slice(0, 10),
      reviewBody: r.verdict,
      reviewRating: { '@type': 'Rating', ratingValue: product.overall, bestRating: 10, worstRating: 0 },
      positiveNotes: { '@type': 'ItemList', itemListElement: r.pros.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })) },
      negativeNotes: { '@type': 'ItemList', itemListElement: r.cons.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })) },
      publisher: { '@type': 'Organization', name: 'BuildNReview' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('breadcrumb.home'), item: new URL(`/${lang}/`, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: cat.name[lang], item: new URL(`/${lang}/category/${cat.id}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.name, item: url },
    ],
  },
];
---
<Base lang={lang} title={r.title} description={r.summary} jsonLd={jsonLd} ogType="article">
  <article>
    <header class="top">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href={`/${lang}/`}>{t('breadcrumb.home')}</a></li>
            <li><a href={`/${lang}/category/${cat.id}/`}>{cat.name[lang]}</a></li>
            <li aria-current="page">{d.model}</li>
          </ol>
        </nav>

        <div class="intro">
          <div class="art-col">
            <ProductArt type={d.type} tone={d.tone} label={d.name} eager />
          </div>
          <div class="info">
            <p class="brand">{d.brand}<span class="sep" aria-hidden="true"></span>{types[d.type]?.[lang]}</p>
            <h1 class="display">{d.name}</h1>
            <p class="summary">{r.summary}</p>

            <div class="scorebox">
              <ScoreRuler value={product.overall} size="lg" label={t('card.score')} />
              <p class="bestfor"><strong>{t('review.bestFor')}:</strong> {r.bestFor}</p>
            </div>

            <div class="buy">
              <p class="price"><span>{t('review.price')}</span> <strong class="num">{formatPrice(lang, d.price)}</strong></p>
              <div class="actions">
                {offers.map((o) => (
                  <a class="btn btn-buy" href={o.url} rel="sponsored nofollow noopener" target="_blank">
                    {t('review.buyAt', { store: o.store })}<Icon name="external" />
                  </a>
                ))}
                <CompareToggle lang={lang} slug={product.id} category={d.category} name={d.name} />
              </div>
            </div>
            <p class="meta">
              {t('review.by', { author: r.author })}. {t('review.updated', { date: formatDate(lang, r.updated ?? r.published) })}.
            </p>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap body">
      {d.sample && (
        <p class="notice"><Icon name="info" />{t('review.sample')}</p>
      )}

      <section class="pc" aria-label={`${t('review.pros')} / ${t('review.cons')}`}>
        <div class="pros">
          <h2>{t('review.pros')}</h2>
          <ul>{r.pros.map((p) => <li><Icon name="plus" size={18} />{p}</li>)}</ul>
        </div>
        <div class="cons">
          <h2>{t('review.cons')}</h2>
          <ul>{r.cons.map((c) => <li><Icon name="minus" size={18} />{c}</li>)}</ul>
        </div>
      </section>

      <div class="columns">
        <div class="main-col">
          <section class="verdict">
            <h2>{t('review.verdict')}</h2>
            <p>{r.verdict}</p>
          </section>
          <div class="prose">
            <Content />
          </div>
        </div>

        <aside class="side">
          <section>
            <h2>{t('review.scores')}</h2>
            <div class="scores">
              {scoreKeys.map((k) => <ScoreRuler value={d.scores[k]} size="sm" label={cat.scoreLabels[k][lang]} />)}
            </div>
          </section>
          <section>
            <h2>{t('review.specs')}</h2>
            <table class="specs">
              <tbody>
                {specs.map((k) => (
                  <tr>
                    <th scope="row">{specLabels[k]?.[lang] ?? k}</th>
                    <td class="num">{specValue(d.specs[k], t('yes'), t('no'))}</td>
                  </tr>
                ))}
                <tr><th scope="row">{lang === 'vi' ? 'Năm ra mắt' : 'Released'}</th><td class="num">{d.released}</td></tr>
              </tbody>
            </table>
          </section>
          <p class="aff">{t('review.affiliate')} <a class="link" href={`/${lang}/disclosure/`}>{t('footer.disclosure')}</a></p>
        </aside>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section related">
      <div class="wrap">
        <div class="section-head"><h2>{t('review.related')}</h2></div>
        <div class="grid">
          {related.map((p) => <ProductCard product={p} lang={lang} compare />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .top { background: var(--surface); border-bottom: 1px solid var(--rule); padding: var(--s-5) 0 var(--s-7); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; font-size: var(--t-sm); color: var(--steel); margin-bottom: var(--s-5); }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: 6px; color: var(--rule-strong); }
  .crumbs a { color: var(--steel); }
  .crumbs a:hover { color: var(--ink); }

  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(24px, 5vw, 72px); align-items: start; }
  .art-col :global(.art) { border: 1px solid var(--rule); border-radius: var(--radius-m); }
  .brand { color: var(--steel); font-size: var(--t-sm); display: flex; align-items: center; gap: 10px; }
  .sep { width: 18px; height: 1px; background: var(--rule-strong); }
  h1 { font-size: clamp(2rem, 1.3rem + 2.8vw, 3.4rem); font-weight: 800; margin: var(--s-2) 0 var(--s-4); }
  .summary { font-size: var(--t-lg); line-height: 1.45; max-width: 40ch; }
  .scorebox { margin: var(--s-6) 0 var(--s-5); padding: var(--s-5) 0; border-block: 1px solid var(--rule); display: grid; gap: var(--s-4); }
  .bestfor { font-size: var(--t-sm); color: var(--steel); }
  .bestfor strong { color: var(--ink); }
  .buy { display: grid; gap: var(--s-3); }
  .price { display: flex; align-items: baseline; gap: var(--s-3); font-size: var(--t-sm); color: var(--steel); }
  .price strong { font-size: var(--t-xl); color: var(--ink); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
  .meta { margin-top: var(--s-5); font-size: var(--t-xs); color: var(--steel); }

  .body { padding-top: var(--s-7); }
  .notice { margin-bottom: var(--s-6); }

  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); margin-bottom: var(--s-7); }
  .pc > div { background: var(--surface); border: 1px solid var(--rule); border-top: 4px solid; border-radius: var(--radius-s); padding: var(--s-5); }
  .pros { border-top-color: var(--good) !important; }
  .cons { border-top-color: var(--bad) !important; }
  .pc h2 { font-size: var(--t-lg); margin-bottom: var(--s-3); }
  .pc ul { list-style: none; display: grid; gap: var(--s-3); }
  .pc li { display: grid; grid-template-columns: 22px 1fr; gap: 8px; }
  .pc li :global(svg) { margin-top: 3px; }
  .pros li :global(svg) { color: var(--good); }
  .cons li :global(svg) { color: var(--bad); }

  .columns { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .verdict { background: var(--ink); color: var(--on-ink); padding: var(--s-6); border-radius: var(--radius-m); margin-bottom: var(--s-6); }
  .verdict h2 { font-size: var(--t-lg); color: var(--signal); margin-bottom: var(--s-3); }
  .verdict p { font-size: var(--t-lg); line-height: 1.5; }

  .side { position: sticky; top: 92px; display: grid; gap: var(--s-6); }
  .side h2 { font-size: var(--t-lg); margin-bottom: var(--s-4); }
  .scores { display: grid; gap: var(--s-4); }
  .specs { width: 100%; border-collapse: collapse; font-size: var(--t-sm); }
  .specs th, .specs td { padding: 10px 0; border-bottom: 1px solid var(--rule); vertical-align: top; text-align: left; }
  .specs th { font-weight: 500; color: var(--steel); padding-right: var(--s-4); width: 48%; }
  .specs td { font-weight: 600; }
  .aff { font-size: var(--t-xs); color: var(--steel); }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--s-5); }

  @media (max-width: 900px) {
    .intro, .columns { grid-template-columns: 1fr; }
    .art-col { max-width: 520px; }
    .side { position: static; }
  }
  @media (max-width: 600px) { .pc { grid-template-columns: 1fr; } }
</style>
