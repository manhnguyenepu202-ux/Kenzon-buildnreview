<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in · BuildNReview Admin</title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Instrument+Serif:ital@1&display=swap">
  <link rel="stylesheet" href="/css/admin.css?v=2">
</head>
<body class="login-body">
  <form class="login" method="post" action="/admin/login">
    <a class="side-logo" href="/en/"><span class="logo-mark">B</span><span>BuildN<em>Review</em></span></a>
    <h1>Admin sign in</h1>
    <% if (error) { %><div class="flash flash-err" role="alert"><%= error %></div><% } %>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email<input type="email" name="email" value="<%= email %>" autocomplete="username" required autofocus></label>
    <label>Password<input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn btn-primary" type="submit">Sign in</button>
    <p class="hint">The admin email and password are set in the server environment (ADMIN_EMAIL, ADMIN_PASSWORD).</p>
  </form>
</body>
</html>
