<%- include('../partials/head') %>
<section class="page-hero page-hero-tall">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap">
    <p class="eyebrow eyebrow-lime"><%= typeof error !== 'undefined' && error ? 'Error 500' : 'Error 404' %></p>
    <h1><%= typeof error !== 'undefined' && error ? 'Something went wrong.' : 'This page fell off the bench.' %></h1>
    <p class="page-lede">Try searching for the product, or start again from the home page.</p>
    <form class="search search-hero search-page" role="search" action="/en/search/" method="get">
      <label class="visually-hidden" for="q-404">Search reviews</label>
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input id="q-404" name="q" type="search" placeholder="Search reviews…">
    </form>
    <p class="mt-lg"><a class="btn btn-ghost-light" href="/en/">Back to home</a></p>
  </div>
</section>
<%- include('../partials/foot') %>
