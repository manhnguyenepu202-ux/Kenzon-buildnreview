<%- include('../partials/head') %>
<article>
  <header class="post-hero">
    <div class="wrap post-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol><li><a href="/en/">Home</a></li><li><a href="/en/blog/">Blog</a></li><li aria-current="page"><%= post.title %></li></ol>
      </nav>
      <p class="eyebrow"><%= post.topic || 'Guide' %></p>
      <h1><%= post.title %></h1>
      <p class="post-lede"><%= post.strapline || post.description %></p>
      <p class="byline">By the BuildNReview team · Published <time datetime="<%= post.date %>"><%= h.fmtDate(post.date) %></time><% if (post.updated && post.updated !== post.date) { %> · Updated <time datetime="<%= post.updated %>"><%= h.fmtDate(post.updated) %></time><% } %> · <%= post.minutes %> min read</p>
      <p class="post-disclosure">When you buy through links on our site, we may earn an affiliate commission. It never changes our verdicts. <a href="/en/disclosure/">Here’s how it works.</a></p>
    </div>
  </header>

  <div class="wrap review-layout">
    <div>
      <p class="post-trust"><strong>Why you can trust BuildNReview</strong> For every product we cover, we compare published test results, owner reports and official specifications, and we show where each number comes from. <a href="/en/how-we-test/">How we review</a></p>
      <div class="prose post-prose"><%- bodyHtml %></div>

      <% if (tutorials.length) { %>
        <div class="post-more">
          <h2>Related guides</h2>
          <% tutorials.slice(0, 3).forEach((t) => { %><p><strong>More:</strong> <a href="<%= t.url %>"><%= t.title %></a></p><% }) %>
        </div>
      <% } %>

      <aside class="post-about">
        <p class="eyebrow">About the author</p>
        <p><strong>The BuildNReview team</strong> researches 3D printers, laser engravers, CNC routers and 3D scanners. We read every independent test we can find, check prices on the brands’ own stores and keep our reviews updated when prices or firmware change. We don’t claim hands-on testing we haven’t done. <a href="/en/about/">About us</a></p>
      </aside>

      <% if (related.length) { %>
        <section class="post-related" aria-labelledby="related-h">
          <h2 id="related-h">Reviews mentioned in this article</h2>
          <div class="grid-cards grid-cards-3">
            <% related.forEach((p) => { %><%- include('../partials/product-card', { p }) %><% }) %>
          </div>
        </section>
      <% } %>

      <nav class="post-nav" aria-label="More articles">
        <% if (newer) { %><a href="<%= newer.url %>"><small>Newer</small><span><%= newer.title %></span></a><% } else { %><span></span><% } %>
        <% if (older) { %><a class="older" href="<%= older.url %>"><small>Older</small><span><%= older.title %></span></a><% } %>
      </nav>
    </div>

    <aside class="review-side">
      <div class="side-sticky">
        <% if (toc.length) { %>
          <nav class="toc" aria-label="On this page">
            <p class="eyebrow">On this page</p>
            <ol><% toc.forEach((t) => { %><li><a href="#<%= t.id %>"><%= t.text %></a></li><% }) %></ol>
          </nav>
        <% } %>
        <div class="toc post-side-more">
          <p class="eyebrow">More from the blog</p>
          <ol><% more.forEach((m) => { %><li><a href="<%= m.url %>"><%= m.title %></a></li><% }) %></ol>
        </div>
      </div>
    </aside>
  </div>
</article>
<%- include('../partials/foot') %>
