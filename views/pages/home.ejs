<%- include('../partials/head') %>
<%
  // Hero tiles: clean product photos, featured products first.
  const tiles = [];
  [...featured, ...popular, ...latest].forEach((p) => {
    if (tiles.length < 4 && p.image_url && !tiles.some((t) => t.p.id === p.id)) tiles.push({ src: p.image_url, p });
  });
  const spotlight = featured[0];
%>
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow eyebrow-lime">Independent 3D printing, DIY &amp; home reviews</p>
      <h1 class="hero-title">Tested on the bench. Trusted at <em>home.</em></h1>
      <p class="hero-lede">BuildNReview compiles deep, structured reviews of 3D printers, laser and CNC add-ons, power tools and home appliances: pros, cons, real use cases, full specs and a transparent score out of 10.</p>
      <form class="search search-hero" role="search" action="/en/search/" method="get" data-search>
        <label class="visually-hidden" for="q-hero">Search reviews</label>
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input id="q-hero" name="q" type="search" autocomplete="off" placeholder="Search <%= total %>+ products by brand or model…" role="combobox" aria-expanded="false" aria-controls="q-hero-list" aria-autocomplete="list">
        <ul id="q-hero-list" class="suggest" role="listbox" hidden></ul>
      </form>
      <ul class="hero-stats">
        <li><strong><%= total %></strong> in-depth reviews</li>
        <li><strong><%= comparisonCount %></strong> head-to-heads</li>
        <li><strong>4</strong> scoring criteria</li>
      </ul>
    </div>
    <div class="hero-tiles" aria-hidden="true">
      <% tiles.slice(0, 4).forEach((t, i) => { %>
        <a class="tile tile-<%= i + 1 %>" href="<%= t.p.url %>" tabindex="-1">
          <img src="<%= h.img(t.src, 560) %>" alt="" width="500" height="500" <%- i < 2 ? 'fetchpriority="high"' : '' %> decoding="async">
          <span class="tile-tag"><span><%= t.p.name %></span> <b><%= t.p.overall.toFixed(1) %></b></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Most-read this week</p>
        <h2>Reviews readers love</h2>
      </div>
      <a class="text-link" href="/en/search/">Browse all reviews</a>
    </div>
    <div class="grid-cards">
      <% popular.forEach((p, i) => { %><%- include('../partials/product-card', { p, eager: i < 4 }) %><% }) %>
    </div>
  </div>
</section>

<section class="section section-tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Editor's picks</p>
        <h2>Browse categories worth your time</h2>
      </div>
    </div>
    <div class="grid-cats">
      <% categories.forEach((c) => { %><%- include('../partials/category-card', { c }) %><% }) %>
    </div>
  </div>
</section>

<% if (spotlight) { %>
<section class="section">
  <div class="wrap">
    <article class="spotlight">
      <div class="spotlight-media">
        <img src="<%= h.img(spotlight.image_url, 900) %>" alt="<%= spotlight.name %>" width="640" height="640" loading="lazy" decoding="async">
      </div>
      <div class="spotlight-body">
        <p class="eyebrow eyebrow-lime">Spotlight review</p>
        <h2><%= spotlight.name %></h2>
        <p class="spotlight-summary"><%= spotlight.verdict %></p>
        <div class="spotlight-score">
          <span class="score-ring" style="--v:<%= spotlight.overall * 10 %>"><strong><%= spotlight.overall.toFixed(1) %></strong><small>/10</small></span>
          <ul>
            <% spotlight.pros.slice(0, 3).forEach((x) => { %><li><%= x %></li><% }) %>
          </ul>
        </div>
        <div class="spotlight-actions">
          <a class="btn btn-lime" href="<%= h.goUrl(spotlight) %>" rel="sponsored nofollow noopener" target="_blank"><%= spotlight.affiliate_label || 'Check price' %><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg></a>
          <a class="btn btn-ghost-light" href="<%= spotlight.url %>">Read the full review</a>
        </div>
      </div>
    </article>
  </div>
</section>
<% } %>

<% if (comparisons.length) { %>
<section class="section section-tint">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Head-to-head</p>
        <h2>Can't decide? We compared them.</h2>
      </div>
      <a class="text-link" href="/en/compare/">All comparisons</a>
    </div>
    <div class="grid-vs">
      <% comparisons.forEach((c) => { %>
        <a class="vs-card" href="<%= c.url %>">
          <div class="vs-visuals">
            <%- h.productVisual(c.products[0]) %>
            <span class="vs-badge">VS</span>
            <%- h.productVisual(c.products[1]) %>
          </div>
          <h3><%= c.title %></h3>
          <p><%= h.truncate(c.intro, 120) %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (guides.length) { %>
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Buying guides</p>
        <h2>The best, ranked</h2>
      </div>
      <a class="text-link" href="/en/best/">All guides</a>
    </div>
    <div class="grid-guides">
      <% guides.forEach((g) => { %>
        <a class="guide-card" href="<%= g.url %>">
          <div class="guide-thumbs">
            <% g.entries.slice(0, 3).forEach((e) => { %><%- h.productVisual(e.product) %><% }) %>
          </div>
          <h3><%= g.title %></h3>
          <ol>
            <% g.entries.slice(0, 3).forEach((e) => { %><li><span><%= e.product.name %></span><strong><%= e.product.overall.toFixed(1) %></strong></li><% }) %>
          </ol>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section section-dark">
  <div class="wrap method">
    <div>
      <p class="eyebrow eyebrow-lime">How we score</p>
      <h2>One number you can <em>actually</em> read.</h2>
      <p>Every product gets four sub-scores out of 10. The overall score is a fixed weighted average, so a 9.0 printer and a 9.0 vacuum mean the same thing: excellent at its job, for its price.</p>
      <a class="btn btn-ghost-light" href="/en/how-we-test/">Read our method</a>
    </div>
    <ul class="method-list">
      <li><strong>35%</strong><span>Performance</span><small>Speed, power, results</small></li>
      <li><strong>25%</strong><span>Build quality</span><small>Materials, finish, durability</small></li>
      <li><strong>20%</strong><span>Ease of use</span><small>Setup, daily handling, cleaning</small></li>
      <li><strong>20%</strong><span>Value</span><small>What you get for the price</small></li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Fresh off the bench</p>
        <h2>Recently updated</h2>
      </div>
    </div>
    <ul class="row-list">
      <% latest.forEach((p) => { %>
        <li>
          <a href="<%= p.url %>" class="row-item">
            <%- h.productVisual(p) %>
            <div>
              <span class="card-brand"><%= p.category ? p.category.name : p.brand %></span>
              <strong><%= p.title || p.name %></strong>
              <small>Updated <%= h.fmtDate(p.updated_at) %></small>
            </div>
            <span class="score-pill"><%= p.overall.toFixed(1) %></span>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
<%- include('../partials/foot') %>
