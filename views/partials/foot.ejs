  </div>
</footer>

<aside class="tray" data-tray hidden aria-live="polite">
  <div class="wrap tray-inner">
    <p class="tray-label"><strong data-tray-count>0</strong> of 4 selected to compare</p>
    <ul class="tray-items" data-tray-items></ul>
    <div class="tray-actions">
      <button type="button" class="btn btn-ghost-light" data-tray-clear>Clear</button>
      <a class="btn btn-lime" href="/en/compare/" data-tray-go>Compare now</a>
    </div>
  </div>
</aside>
<script src="/js/site.js?v=2" defer></script>
