        <span class="logo-mark" aria-hidden="true">B</span>
        <span class="logo-text">BuildN<em>Review</em></span>
      </a>
      <p><%= settings.site_tagline %></p>
      <p class="footer-disclosure"><%= settings.disclosure_short %> <a href="/en/disclosure/">Learn more</a>.</p>
    </div>
    <div>
      <h2>Categories</h2>
      <ul><% navCategories.forEach((c) => { %><li><a href="<%= c.url %>"><%= c.name %></a></li><% }) %></ul>
    </div>
    <div>
      <h2>Explore</h2>
      <ul>
        <li><a href="/en/best/">Best-of guides</a></li>
        <li><a href="/en/compare/">Compare products</a></li>
        <li><a href="/en/how-we-test/">How we test</a></li>
        <li><a href="/en/search/">Search</a></li>
      </ul>
    </div>
    <div>
      <h2>About</h2>
      <ul>
        <li><a href="/en/about/">About us</a></li>
        <li><a href="/en/disclosure/">Affiliate disclosure</a></li>
        <li><a href="/en/privacy/">Privacy policy</a></li>
        <li><a href="mailto:<%= settings.contact_email %>"><%= settings.contact_email %></a></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <p>© <%= new Date().getFullYear() %> BuildNReview. All rights reserved.</p>
